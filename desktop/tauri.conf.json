{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CUBE-PDF",
  "mainBinaryName": "CUBE-PDF",
  "identifier": "io.github.kseen715.ocr-pdf",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "CUBE-PDF",
        "width": 1040,
        "height": 760,
        "minWidth": 480,
        "minHeight": 560,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https://api.github.com",
        "img-src": "'self' data: blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright © 2026 Denis Korenev",
    "license": "AGPL-3.0-or-later",
    "publisher": "Denis Korenev",
    "shortDescription": "Searchable PDF from scans",
    "longDescription": "Makes searchable PDF/A from scans and photos",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": ["binaries/ocr-pdf-core", "binaries/ocr-pdf-gs"],
    "resources": {
      "tessdata/": "tessdata/",
      "LICENSE.txt": "LICENSE.txt",
      "THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Russian", "English"]
      }
    },
    "linux": {
      "deb": {
        "section": "graphics"
      }
    }
  }
}
